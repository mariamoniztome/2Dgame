{
  "name": "bruxa-bruxinha",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.bruxa-bruxinha",
    "productName": "Bruxa Bruxinha",
    "publish": null,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "phaser": "^3.60.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.2.0",
    "wait-on": "^7.2.0"
  }
}
